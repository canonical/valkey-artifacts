#!/bin/sh -e

# Older revisions kept the config in $SNAP_DATA. A copy there is the config
# the server last ran with, so it replaces the one in $SNAP_COMMON.
OLD="${SNAP_DATA}"/etc/valkey
NEW="${SNAP_COMMON}"/etc/valkey
if [ -d "${OLD}" ]; then
    rm -rf "${NEW}"
    mkdir -p "${SNAP_COMMON}"/etc
    mv "${OLD}" "${NEW}"
fi
